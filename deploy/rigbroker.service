# /etc/systemd/system/rigbroker.service
# Hardware mode, READ-ONLY (no --allow-tx): tunes the rig, runs only receive-only consumers.
# To allow transmitting later (after dummy-load tests), add --allow-tx via a drop-in:
#   sudo systemctl edit rigbroker   ->  [Service]
#                                       ExecStart=
#                                       ExecStart=/opt/rigbroker/.venv/bin/rigbroker --config /etc/rigbroker/profiles.yaml --log-json --allow-tx
# Runs as the unprivileged "rigbroker" user; unit control goes through the polkit rule in
# deploy/50-rigbroker.rules (only its own units), so the broker never needs sudo.
[Unit]
Description=RigBroker radio resource broker
After=network-online.target rigctld-vu.service
Wants=network-online.target

[Service]
Type=exec
User=rigbroker
Group=rigbroker
WorkingDirectory=/opt/rigbroker
ExecStart=/opt/rigbroker/.venv/bin/rigbroker --config /etc/rigbroker/profiles.yaml --log-json
Restart=on-failure
RestartSec=5
Environment=HOME=/var/lib/rigbroker
StateDirectory=rigbroker
StateDirectoryMode=0700

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
