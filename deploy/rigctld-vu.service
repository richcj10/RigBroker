# /etc/systemd/system/rigctld-vu.service - Hamlib rigctld for the ID-4100A (radio "vu")
# Digirig: CP2102N serial (CI-V + PTT on RTS) + C-Media audio. Bench-tested 2026-11-08.
# CI-V address 0x9A, 9600 baud (as set in the radio: SET > Function > CI-V).
#
# NOTE: each rigctld START briefly asserts RTS (= Digirig PTT) for ~55 ms before Hamlib
# drops it (measured). Keep rigctld long-running; restart it as rarely as possible.
#
# Tied to the Digi-Rig's USB serial device: when it is unplugged (or drops off USB)
# systemd stops rigctld (otherwise it can hang on the dead port), and when it comes
# back systemd starts rigctld again. Device unit name from:
#   systemd-escape -p --suffix=device /dev/serial/by-id/usb-Silicon_Labs_...-port0
[Unit]
Description=rigctld for ID-4100A (RigBroker radio "vu")
BindsTo=dev-serial-by\x2did-usb\x2dSilicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_9846aeb62cc6ef1188be69527a5e3baa\x2dif00\x2dport0.device
After=dev-serial-by\x2did-usb\x2dSilicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_9846aeb62cc6ef1188be69527a5e3baa\x2dif00\x2dport0.device
# also restart on any exit of its own, forever (no start-rate limit)
StartLimitIntervalSec=0

[Service]
Type=exec
User=ham
Group=dialout
ExecStart=/usr/bin/rigctld -m 3082 \
  -r /dev/serial/by-id/usb-Silicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_9846aeb62cc6ef1188be69527a5e3baa-if00-port0 \
  -s 9600 -T 127.0.0.1 -t 4542 \
  --set-conf=civaddr=0x9A,ptt_type=RTS
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
# started at boot, and again whenever the Digi-Rig's serial device appears
WantedBy=multi-user.target dev-serial-by\x2did-usb\x2dSilicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_9846aeb62cc6ef1188be69527a5e3baa\x2dif00\x2dport0.device
